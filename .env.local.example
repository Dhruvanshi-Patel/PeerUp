# .env.local — Local dev environment variables for Turso
# Copy this file to .env.local and fill in your actual Turso credentials.
# NEVER commit .env.local to git.

# Get these from: https://turso.tech/app → your database → "Connect" tab
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here
